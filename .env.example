# ============================================================
# RakshaCall Environment Configuration
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real API keys to version control.
# ============================================================

# Database (PostgreSQL recommended for production)
DATABASE_URL=postgresql+psycopg://raksha:password@localhost:5432/rakshacall
# For local development with SQLite:
# DATABASE_URL=sqlite:///./rakshacall.db

# Authentication
JWT_SECRET=replace-with-a-long-random-secret-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=720

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AI Model Mode
MODEL_MODE=neural-multilingual-v2+safety-floor

# Google Gemini Live (optional — enables real-time multimodal analysis)
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash

# Groq Cloud LLM (optional — enables cloud-enhanced semantic analysis)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Twilio SMS (optional — enables real SMS delivery to trusted contacts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Backend
BACKEND_BASE_URL=http://localhost:8000
